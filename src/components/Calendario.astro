    position: relative;
  }

  #dia-especial::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 0.5rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    pointer-events: none;
  }

  .dia-calendario:hover {
    transform: translateY(-2px);
  }
</style>